@PACKAGE_INIT@
set(iiDeviceMultimedia_SPDX_LICENSE "Apache-2.0")
if(EMSCRIPTEN AND @BUILD_SHARED_LIBS@)
    # Emscripten's CMake toolchain defaults to static libraries even when the
    # installed SDK was deliberately built as a WebAssembly side module.
    set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
endif()
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@IIDEVICEMULTIMEDIA_PACKAGE_LINUX_IO@)
    find_dependency(PkgConfig)
    pkg_check_modules(IIDEVICEMULTIMEDIA_LINUX_IO REQUIRED IMPORTED_TARGET libudev dbus-1 alsa>=1.2.10)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiDeviceMultimediaTargets.cmake")
check_required_components(iiDeviceMultimedia)
