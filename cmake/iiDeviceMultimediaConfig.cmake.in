@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@IIDEVICEMULTIMEDIA_PACKAGE_LINUX_IO@)
    find_dependency(PkgConfig)
    pkg_check_modules(IIDEVICEMULTIMEDIA_LINUX_IO REQUIRED IMPORTED_TARGET libudev dbus-1 alsa>=1.2.10)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiDeviceMultimediaTargets.cmake")
check_required_components(iiDeviceMultimedia)
